---
import { Icon } from 'astro-icon/components';
import type { PracticeArea } from '../data/practice-areas';

interface Props {
  area: PracticeArea;
}
const { area } = Astro.props;
---

<a
  href={`/areas/${area.slug}`}
  class="group relative block overflow-hidden rounded-2xl min-h-[300px]"
>
  <img
    src={area.image}
    alt={area.title}
    class="absolute inset-0 w-full h-full object-cover scale-105 group-hover:scale-110 transition duration-700"
    loading="lazy"
  />
  <div
    class="absolute inset-0 bg-linear-to-t from-primary-dark/98 via-primary-dark/90 to-primary-dark/20"
    aria-hidden="true"
  ></div>
  <div class="absolute inset-0 flex flex-col justify-end p-6">
    <div
      class="w-10 h-10 flex items-center justify-center rounded-lg bg-accent/20 border border-accent/40 text-accent-light mb-3"
    >
      <Icon name={area.icon} class="text-lg" />
    </div>
    <h3 class="font-heading text-xl font-bold text-white mb-2">{area.title}</h3>
    <p class="text-sm text-neutral-300 leading-relaxed mb-3 line-clamp-2">{area.summary}</p>
    <span class="inline-flex items-center gap-1 text-sm font-semibold text-accent-light">
      Saiba mais
      <Icon name="bi:arrow-right" class="text-xs group-hover:translate-x-1 transition" />
    </span>
  </div>
</a>
