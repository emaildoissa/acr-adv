---
import { Icon } from 'astro-icon/components';
import { nav, site } from '../data/site';
import { practiceAreas } from '../data/practice-areas';

const pathname = Astro.url.pathname;

const isActive = (href: string) => {
  if (href === '/') return pathname === '/';
  if (href === '/areas') {
    return pathname === '/areas' || pathname.startsWith('/areas/');
  }
  return pathname === href || pathname.startsWith(href + '/');
};

const mainItems = nav.filter((item) => item.href !== '/areas');
const areaItem = nav.find((item) => item.href === '/areas')!;
---

<header class="bg-primary-dark border-b border-white/10 sticky top-0 z-50 transition-shadow duration-300">
  <div class="container-content">
    <div class="flex justify-between items-center h-24">
      <!-- Logo -->
      <div class="flex items-center">
        <a href="/" class="flex items-center py-2" aria-label={site.name}>
          <img src="/img/logo.png" alt={site.name} class="h-20 w-auto object-contain" />
        </a>
      </div>

      <!-- Desktop Nav -->
      <nav class="hidden lg:flex items-center gap-8" aria-label="Navegação principal">
        {mainItems.map((item) => (
          <a
            href={item.href}
            class:list={[
              'py-3 font-medium transition text-neutral-200 hover:text-accent-light',
              isActive(item.href) ? 'text-accent-light' : '',
            ]}
          >
            {item.label}
          </a>
        ))}
        <div class="relative" x-data="{ open: false }" x-on:mouseenter="open = true" x-on:mouseleave="open = false">
          <button
            class:list={[
              'py-3 font-medium inline-flex items-center gap-1 transition hover:text-accent-light',
              isActive('/areas') ? 'text-accent-light' : 'text-neutral-200',
            ]}
            aria-haspopup="true"
          >
            {areaItem.label}
            <Icon name="bi:chevron-down" class="text-xs" />
          </button>
          <div
            x-show="open"
            x-transition
            class="absolute top-full left-0 w-96 bg-white shadow-xl rounded-lg border border-border p-6 grid grid-cols-2 gap-4"
          >
            {practiceAreas.map((area) => (
              <a href={`/areas/${area.slug}`} class="text-sm transition text-body hover:text-accent">
                {area.title}
              </a>
            ))}
          </div>
        </div>
      </nav>

      <!-- Desktop CTA -->
      <div class="hidden lg:flex items-center gap-4">
        <a href={`tel:${site.phone.replace(/\D/g, '')}`} class="relative">
          <div class="flex items-center gap-2 text-accent-light hover:text-white transition">
            <Icon name="bi:telephone-fill" class="text-3xl" />
            <div class="flex flex-col">
              <span class="text-xs tracking-widest text-neutral-300">Fale conosco</span>
              <span class="text-lg font-bold">{site.phone}</span>
            </div>
          </div>
        </a>
      </div>

      <!-- Mobile Menu Button -->
      <div class="lg:hidden flex items-center gap-3">
        <button
          @click="mobileMenuOpen = !mobileMenuOpen"
          class="inline-flex items-center justify-center w-12 h-12 text-white"
          aria-label="Abrir menu"
        >
          <Icon name="bi:list" class="text-3xl" x-show="!mobileMenuOpen" />
          <Icon name="bi:x" class="text-3xl" x-show="mobileMenuOpen" style="display:none;" />
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile Menu -->
  <div
    x-show="mobileMenuOpen"
    x-transition
    class="lg:hidden border-t border-white/10 bg-primary-dark"
    x-on:click.outside="mobileMenuOpen = false"
  >
    <div class="container-content py-6 space-y-4 h-[85vh] overflow-y-auto">
      <div class="space-y-3">
        {mainItems.map((item) => (
          <a
            href={item.href}
            class:list={['block py-2 font-medium text-neutral-200 hover:text-accent-light', isActive(item.href) ? 'text-accent-light' : '']}
          >
            {item.label}
          </a>
        ))}
        <div x-data="{ open: false }">
          <button
            x-on:click="open = !open"
            class="w-full text-left font-medium flex justify-between items-center py-2 text-neutral-200 hover:text-accent-light"
          >
            {areaItem.label}
            <span class="transition" x-bind:class="{ 'rotate-180': open }">
              <Icon name="bi:chevron-down" />
            </span>
          </button>
          <div x-show="open" x-transition class="pl-4 pt-2 space-y-2">
            {practiceAreas.map((area) => (
              <a href={`/areas/${area.slug}`} class="block py-1 text-sm text-neutral-400 hover:text-accent-light">
                {area.title}
              </a>
            ))}
          </div>
        </div>
      </div>
      <div class="pt-4 border-t border-border">
        <a
          href={site.whatsappUrl}
          target="_blank"
          rel="noopener"
          class="inline-flex items-center justify-center gap-2 w-full px-6 py-3 bg-accent text-white rounded-lg hover:bg-accent-dark transition font-semibold"
        >
          <Icon name="bi:whatsapp" />
          Agendar consulta
        </a>
      </div>
    </div>
  </div>
</header>
