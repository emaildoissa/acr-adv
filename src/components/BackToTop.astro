<button
  x-data="{ show: false }"
  x-init="window.addEventListener('scroll', () => { show = window.scrollY > 400 })"
  x-show="show"
  x-transition
  x-cloak
  @click="window.scrollTo({ top: 0, behavior: 'smooth' })"
  class="fixed bottom-6 right-6 z-40 w-12 h-12 flex items-center justify-center rounded-full bg-primary text-white shadow-lg hover:bg-primary-hover transition"
  aria-label="Voltar ao topo"
>
  <svg xmlns="http://www.w3.org/2000/svg" width="1.25em" height="1.25em" viewBox="0 0 16 16" fill="currentColor">
    <path fill-rule="evenodd" d="M8 15a.5.5 0 0 0 .5-.5V2.707l3.146 3.147a.5.5 0 0 0 .708-.708l-4-4a.5.5 0 0 0-.708 0l-4 4a.5.5 0 1 0 .708.708L7.5 2.707V14.5a.5.5 0 0 0 .5.5"/>
  </svg>
</button>
